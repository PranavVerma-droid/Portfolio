---
import Base from '../../layouts/Base.astro';
import TextLink from '../../components/TextLink.astro';
import DevLog from '../../components/DevLog.astro';
import { getProjectBySlug } from '../../lib/projects';
import { url } from '../../lib/url';
import { stripHtml } from '../../lib/format';

const p = await getProjectBySlug(Astro.params.slug!);
if (!p?.writeup) return Astro.rewrite('/404');
const w = p.writeup;
const dates = p.start || p.end ? `${p.start || '?'} → ${p.end || 'present'}` : '';
const description = stripHtml(p.description).slice(0, 160) || p.name;
---
<Base title={p.name} description={description} section="projects">
  <article class="page">
    <div class="title-block">
      <p class="meta-line">
        <span>{w.kind === 'devlog' ? 'dev log' : 'write-up'}</span>
        {p.year && <><span>·</span><span>{p.year}</span></>}
        {p.inProgress && <><span>·</span><span class="sample">in progress</span></>}
      </p>
      <h1 class="display">{p.name}</h1>
      {p.description && <div class="lede muted rich" set:html={p.description} />}
    </div>

    <dl class="spec">
      {p.role && <div class="spec-row"><dt>Role</dt><dd>{p.role}</dd></div>}
      {dates && <div class="spec-row"><dt>Dates</dt><dd>{dates}</dd></div>}
      {p.tags.length > 0 && (
        <div class="spec-row"><dt>Tags</dt><dd><span class="tags spec-tags">{p.tags.map((t) => <span class="tag">{t}</span>)}</span></dd></div>
      )}
      {p.links.length > 0 && (
        <div class="spec-row"><dt>Links</dt><dd><ul class="row-links spec-links">{p.links.map((l) => <li><TextLink href={l.href}>{l.label}</TextLink></li>)}</ul></dd></div>
      )}
    </dl>

    {w.kind === 'devlog' ? (
      <DevLog log={w.log} />
    ) : (
      <div class="log">
        <section class="log-entry" aria-label={w.date ? `Published ${w.date}` : 'Write-up'}>
          {w.date && <p class="meta-line"><span>published</span><span>·</span><time datetime={w.date}>{w.date}</time></p>}
          <div class="prose" set:html={w.html} />
        </section>
      </div>
    )}

    <p><TextLink href={url('/projects/')}>All projects</TextLink></p>
  </article>
</Base>
