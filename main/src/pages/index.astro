---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Empty from '../components/Empty.astro';
import Skeleton, { type SkeletonKind } from '../components/Skeleton.astro';
import HomeSection, { type HomeSectionId } from '../components/islands/HomeSection.astro';
import { getGeneral } from '../lib/general';

/*
  Only About renders with the page (it also feeds the meta description). The other sections
  load after it as server islands, each behind a skeleton shaped like its list.
*/
const general = await getGeneral();
const description = general?.aboutText.slice(0, 160) || 'Pranav Verma builds compilers, ML systems and the self-hosted infrastructure they run on.';

const sections: { id: HomeSectionId; label: string; skeleton: SkeletonKind }[] = [
  { id: 'education', label: 'Education', skeleton: 'index' },
  { id: 'projects', label: 'Projects', skeleton: 'projects' },
  { id: 'writing', label: 'Writing', skeleton: 'posts' },
  { id: 'elsewhere', label: 'Elsewhere', skeleton: 'links' },
];
---
<Base description={description}>
  <div class="page">
    <h1 class="display">Pranav Verma</h1>

    {general ? (
      <Section label="About" id="about">
        <div class="prose" set:html={general.about} />
        {general.resume && (
          <p class="more">
            <a class="link" href={general.resume.href} download>Download résumé</a>
            {general.resume.type && <span class="date"> {general.resume.type}</span>}
          </p>
        )}
      </Section>
    ) : <Empty />}

    {sections.map((s) => (
      <HomeSection server:defer id={s.id} label={s.label}>
        <Section slot="fallback" label={s.label} id={s.id} busy>
          <Skeleton kind={s.skeleton} label={s.label} />
        </Section>
      </HomeSection>
    ))}
  </div>
</Base>
