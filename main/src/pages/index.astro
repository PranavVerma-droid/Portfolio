---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import ProjectIndex from '../components/ProjectIndex.astro';
import PostList from '../components/PostList.astro';
import Elsewhere from '../components/Elsewhere.astro';
import TextLink from '../components/TextLink.astro';
import Empty from '../components/Empty.astro';
import { getGeneral } from '../lib/general';
import { getProjects } from '../lib/projects';
import { getPosts } from '../lib/posts';
import { getSocials, EMAILS } from '../lib/socials';

const HOME_POSTS = 5;

const [general, projects, posts, socials] = await Promise.all([getGeneral(), getProjects(), getPosts(), getSocials()]);
const pinned = projects.filter((p) => p.pinned);
const description = general?.aboutText.slice(0, 160) || 'Pranav Verma builds compilers, ML systems and the self-hosted infrastructure they run on.';
---
<Base description={description}>
  <div class="page">
    {general ? (
      <Section label="About" id="about">
        <div class="prose" set:html={general.about} />
        {general.resume && (
          <p class="more">
            <a class="link" href={general.resume.href} download>Download résumé</a>
            {general.resume.type && <span class="date"> {general.resume.type}</span>}
          </p>
        )}
      </Section>
    ) : <Empty />}

    {projects.length > 0 && (
      <Section label="Projects" id="projects">
        {pinned.length > 0 && <ProjectIndex items={pinned} />}
        <p class:list={[pinned.length > 0 ? 'more' : 'flush']}><TextLink href="/projects/">All projects →</TextLink></p>
      </Section>
    )}

    {posts.length > 0 && (
      <Section label="Writing" id="writing">
        <PostList items={posts.slice(0, HOME_POSTS)} />
        <p class="more"><TextLink href="/writing/">All writing →</TextLink></p>
      </Section>
    )}

    <Section label="Elsewhere" id="elsewhere">
      <Elsewhere socials={socials} emails={EMAILS} />
    </Section>
  </div>
</Base>
