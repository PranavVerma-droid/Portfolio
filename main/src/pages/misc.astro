---
/* Everything that isn't projects or writing. Linked from the nav only. Education (institutes) is on the home page. */
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Skeleton, { type SkeletonKind } from '../components/Skeleton.astro';
import MiscSection, { type MiscSectionId } from '../components/islands/MiscSection.astro';

/*
  The title shows at once; each section loads after it as a server island, behind a skeleton
  shaped like its list. "Last listened" shows nothing if there's no recent listen.
*/
const sections: { id: MiscSectionId; label: string; skeleton: SkeletonKind }[] = [
  { id: 'listening', label: 'Last listened', skeleton: 'song' },
  { id: 'internships', label: 'Internships', skeleton: 'index' },
  { id: 'volunteering', label: 'Volunteering', skeleton: 'index' },
  { id: 'publications', label: 'Publications', skeleton: 'index' },
  { id: 'scores', label: 'Test scores', skeleton: 'index' },
  { id: 'certifications', label: 'Certifications', skeleton: 'chips' },
  { id: 'competitions', label: 'Competitions', skeleton: 'compact' },
  { id: 'languages', label: 'Programming languages', skeleton: 'chips' },
  { id: 'skills', label: 'Skills', skeleton: 'chips' },
  { id: 'trips', label: 'Trips', skeleton: 'trips' },
];
---
<Base title="Misc" description="Internships, volunteering, publications, test scores, certifications, competitions, skills and trips of Pranav Verma." section="misc">
  <div class="page">
    <div class="title-block">
      <h1 class="display">Misc</h1>
      <p class="lede muted">Everything that isn't a project or a post.</p>
    </div>

    {sections.map((s) => (
      <MiscSection server:defer id={s.id} label={s.label}>
        <Section slot="fallback" label={s.label} id={s.id} busy>
          <Skeleton kind={s.skeleton} label={s.label} />
        </Section>
      </MiscSection>
    ))}
  </div>
</Base>
