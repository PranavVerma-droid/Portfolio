---
/* Everything that isn't projects or writing. Linked from the nav only, not the home page. */
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import EntryIndex from '../components/EntryIndex.astro';
import Empty from '../components/Empty.astro';
import ChipList from '../components/ChipList.astro';
import { getEducation, type Education } from '../lib/education';
import { getLanguages, getSkills } from '../lib/skills';
import { getInternships, type Internship } from '../lib/internships';
import { getPublications, type Publication } from '../lib/publications';
import { getCertificates } from '../lib/certificates';
import { getCompetitions } from '../lib/competitions';
import CompactList from '../components/CompactList.astro';
import Trips from '../components/Trips.astro';
import { getTrips } from '../lib/trips';
import LastSong from '../components/LastSong.astro';
import { getLastSong } from '../lib/listening';

const [{ institutes, scores }, internships, publications, certificates, competitions, languages, skills, trips, song] = await Promise.all([
  getEducation(), getInternships(), getPublications(), getCertificates(), getCompetitions(), getLanguages(), getSkills(), getTrips(),
  getLastSong(),
]);
const month = (d: string) => d.slice(0, 7);
const range = (start: string, end: string) => (start || end ? `${month(start) || '?'} → ${end ? month(end) : 'present'}` : '');

const institute = (e: Education) => ({
  ...e,
  meta: range(e.start, e.end) || undefined,
  status: e.start && !e.end ? 'current' : undefined,
});
const score = (e: Education) => ({ ...e, meta: e.start ? month(e.start) : undefined });
const internship = (i: Internship) => ({
  ...i,
  meta: [i.institute, i.type, range(i.start, i.end)].filter(Boolean).join(' · ') || undefined,
  status: i.start && !i.end ? 'current' : undefined,
});
const publication = (p: Publication) => ({ ...p, meta: [p.journal, p.date].filter(Boolean).join(' · ') || undefined });
---
<Base title="Misc" description="Education, internships, publications, test scores, certifications, competitions, skills and trips of Pranav Verma." section="misc">
  <div class="page">
    <div class="title-block">
      <h1 class="display">Misc</h1>
      <p class="lede muted">Everything that isn't a project or a post.</p>
    </div>

    {song && (
      <Section label="Last listened" id="listening">
        <LastSong song={song} />
      </Section>
    )}

    <Section label="Education" id="education">
      {institutes.length ? <EntryIndex items={institutes.map(institute)} /> : <Empty />}
    </Section>

    <Section label="Internships" id="internships">
      {internships.length ? <EntryIndex items={internships.map(internship)} collapse /> : <Empty />}
    </Section>

    <Section label="Publications" id="publications">
      {publications.length ? <EntryIndex items={publications.map(publication)} collapse /> : <Empty />}
    </Section>

    <Section label="Test scores" id="scores">
      {scores.length ? <EntryIndex items={scores.map(score)} /> : <Empty />}
    </Section>

    <Section label="Certifications" id="certifications">
      {certificates.length ? <ChipList items={certificates} id="cert" /> : <Empty />}
    </Section>

    <Section label="Competitions" id="competitions">
      {competitions.length
        ? <CompactList items={competitions.map((c) => ({ ...c, status: c.won ? 'won' : undefined }))} />
        : <Empty />}
    </Section>

    <Section label="Programming languages" id="languages">
      {languages.length ? <ChipList items={languages} id="lang" /> : <Empty />}
    </Section>

    <Section label="Skills" id="skills">
      {skills.length ? <ChipList items={skills} id="skill" /> : <Empty />}
    </Section>

    <Section label="Trips" id="trips">
      {trips.length ? <Trips trips={trips} /> : <Empty />}
    </Section>
  </div>
</Base>
