---
/* Wordmark, up to four links, theme toggle. The home page passes no section and gets no nav. */
interface Props { section?: 'work' | 'writing' | 'now' | 'infra' | 'none' }
const { section } = Astro.props;
// Sections are added one at a time; list only the ones that have pages.
const links = ['work'] as const;
---
<header class="header">
  <a class="wordmark" href="/">pranavv</a>
  <nav class="nav" aria-label="Primary">
    {section && links.map((l) => (
      <a class="navlink" href={`/${l}/`} aria-current={section === l ? 'page' : undefined}>{l}</a>
    ))}
    <button class="toggle" type="button" id="theme-toggle">dark</button>
  </nav>
</header>
