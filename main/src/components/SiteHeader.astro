---
/* Wordmark, up to four links, theme toggle. `section` marks the current link; the home page passes none. */
export type NavSection = 'projects' | 'writing' | 'misc' | 'none';
interface Props { section?: NavSection }
const { section } = Astro.props;
// Sections are added one at a time; list only the ones that have pages.
const links = ['projects', 'writing', 'misc'] as const;
---
<header class="header">
  <a class="wordmark" href="/">pranavv</a>
  <nav class="nav" aria-label="Primary">
    {links.map((l) => (
      <a class="navlink" href={`/${l}/`} aria-current={section === l ? 'page' : undefined}>{l}</a>
    ))}
    <button class="toggle" type="button" id="theme-toggle">dark</button>
  </nav>
</header>
