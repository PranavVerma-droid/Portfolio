---
/*
  The home page's "Now" section: what I'm doing right now, written by a model from every dated
  collection (lib/now.ts) and streamed in from /api/now, token by token, on each page view.
  Three skeleton lines hold its place until the first words arrive; the text never runs past
  three lines, so nothing below it moves. While the model works, the meta line shows a spinner,
  a shimmering verb and a live (seconds · tokens) count; once it's done, the AI warning stays.
*/
import Section from './Section.astro';
import { url } from '../lib/url';

const W = ['94%', '88%', '52%'];
---
<Section label="Now" id="now">
  <div class="now" data-now={url('/api/now')}>
    <p class="now-text" aria-live="polite" aria-busy="true">
      <span class="now-sk" aria-hidden="true">{W.map((w) => <span class="sk-bar sk-line" style={`width:${w}`} />)}</span>
      <span class="sr-only">Writing what I'm doing now…</span>
    </p>
    <p class="meta-line now-meta">
      <span class="now-spin" aria-hidden="true">
        <span class="now-glyph">✻</span>
        <span class="now-verb">Thinking…</span>
        <span class="now-count"></span>
      </span>
      <span>AI generated, may be false</span>
      <span>Plus, this is a shitty model and a shitty server!</span>
      <span class="now-state"></span>
    </p>
    <noscript>
      <style is:inline>.now-text, .now-meta { display: none !important; }</style>
      <p class="muted now-fallback">This section is written live and needs JavaScript.</p>
    </noscript>
  </div>
</Section>

<script>
  /* Reads the event stream from /api/now (see lib/now.ts) and writes each token as it arrives. */
  const GLYPHS = ['·', '✢', '✳', '✶', '✻', '✽', '✻', '✶', '✳', '✢'];
  const WAITING = ['Thinking', 'Recalling', 'Checking dates', 'Pondering', 'Cross-referencing', 'Compiling'];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const root of document.querySelectorAll<HTMLElement>('[data-now]')) {
    const text = root.querySelector<HTMLElement>('.now-text')!;
    const glyph = root.querySelector<HTMLElement>('.now-glyph')!;
    const verb = root.querySelector<HTMLElement>('.now-verb')!;
    const count = root.querySelector<HTMLElement>('.now-count')!;
    const state = root.querySelector<HTMLElement>('.now-state')!;
    const t0 = performance.now();
    let tokens = 0;
    let frame = 0;

    // The spinner: glyph every 120ms, verb every 2.4s until the first token, count every tick.
    const tick = () => {
      frame++;
      if (!reduce) glyph.textContent = GLYPHS[frame % GLYPHS.length];
      if (!tokens) verb.textContent = `${WAITING[Math.floor(frame / 20) % WAITING.length]}…`;
      const s = Math.floor((performance.now() - t0) / 1000);
      count.textContent = `(${s}s${tokens ? ` · ${tokens} token${tokens === 1 ? '' : 's'}` : ''})`;
    };
    tick();
    const timer = setInterval(tick, 120);

    const stop = (note: string) => {
      clearInterval(timer);
      root.classList.add('now-done');
      state.textContent = note;
      text.setAttribute('aria-busy', 'false');
    };
    const fail = () => {
      if (tokens) return stop('stopped early');
      root.classList.add('now-failed');
      text.textContent = "Couldn't write this right now. Reload to try again.";
      stop('');
    };
    const write = (t: string) => {
      if (!tokens) { text.textContent = ''; verb.textContent = 'Writing…'; }
      tokens++;
      text.append(t);
    };

    (async () => {
      const res = await fetch(root.dataset.now!, { cache: 'no-store', headers: { accept: 'text/event-stream' } });
      if (!res.ok || !res.body) return fail();
      const reader = res.body.pipeThrough(new TextDecoderStream()).getReader();
      let buffer = '';
      for (;;) {
        const { value, done } = await reader.read();
        if (done) return tokens ? stop('') : fail();
        buffer += value;
        // Events end with a blank line; the last piece may be incomplete.
        const events = buffer.split('\n\n');
        buffer = events.pop()!;
        for (const raw of events) {
          let event = 'message', data = '';
          for (const line of raw.split('\n')) {
            if (line.startsWith('event:')) event = line.slice(6).trim();
            else if (line.startsWith('data:')) data += line.slice(5).trim();
          }
          if (!data) continue; // a ping
          const msg = JSON.parse(data);
          if (event === 'message') write(msg.t);
          else if (event === 'done') return stop(msg.source === 'last' ? 'earlier note' : '');
          else return fail();
        }
      }
    })().catch(fail);
  }
</script>

<style>
  /* Three body lines (30px each), reserved before and clamped after. */
  .now-text { margin: 0; min-height: 90px; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; line-clamp: 3; overflow: hidden; text-wrap: pretty; }
  .now-sk { display: block; width: 100%; }
  .now-meta { margin-top: var(--space-2); }
  .now-state:empty { display: none; }

  /* Spinner, in the manner of Claude Code: a cycling glyph and a verb with a light sweeping across it. */
  .now-spin { display: inline-flex; gap: var(--space-2); align-items: baseline; }
  .now-glyph { display: inline-block; width: 1ch; text-align: center; color: var(--signal); }
  .now-verb {
    color: var(--ink-muted);
    background: linear-gradient(90deg, var(--ink-muted) 0%, var(--ink-muted) 40%, var(--signal) 50%, var(--ink-muted) 60%, var(--ink-muted) 100%);
    background-size: 300% 100%;
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: now-shimmer 2s linear infinite;
  }
  @keyframes now-shimmer { from { background-position: 100% 0; } to { background-position: 0 0; } }
  .now-done .now-spin { display: none; }

  .now-failed .now-text { color: var(--ink-muted); }
  .now-failed .now-meta { display: none; }
  .now-fallback { margin: 0; font-size: 16px; line-height: 24px; }

  /* Reduced motion (site.css stops every animation): the glyph stays still and the verb is plain text. */
  @media (prefers-reduced-motion: reduce) {
    .now-verb { -webkit-text-fill-color: currentColor; background: none; }
  }
</style>
