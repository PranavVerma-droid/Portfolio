---
/* Dated list of posts. One date format per list: pass one, or it picks "Oct 02" or "2025" (see listDate). */
import TextLink from './TextLink.astro';
import { listDate } from '../lib/format';
import { postHref, type Post } from '../lib/posts';
interface Props { items: Post[]; dateFormat?: (date: string) => string }
const { items } = Astro.props;
const fmt = Astro.props.dateFormat ?? listDate(items.map((p) => p.date));
---
<ol class="posts">
  {items.map((p) => (
    <li class="post">
      <time class="date" datetime={p.date}>{fmt(p.date)}</time>
      <span>
        <TextLink href={postHref(p)}>{p.title}</TextLink>
        {p.kind === 'devlog' && <span class="post-kind">dev log</span>}
      </span>
    </li>
  ))}
</ol>
