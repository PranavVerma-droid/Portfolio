# Host port the site is published on.
PORT=5646
# PocketBase instance the site reads from.
PB_URL=https://pb-1.pranavv.co.in
# Ollama host that writes the home page's Now note, and the model built from ollama/Modelfile.
# Use a direct URL (e.g. http://<tailscale-ip>:11434): a buffering proxy like Cloudflare stops it streaming.
OLLAMA_URL=https://ollama.pranavv.co.in
OLLAMA_MODEL=pranavv-now
